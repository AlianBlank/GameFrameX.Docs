{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "catalog-template.schema.json",
  "title": "GameFrameX 文档目录骨架模板",
  "description": "gfx-config/catalog-template.json 的校验 schema。rootDomains 是 9 域 IA 的唯一权威定义，repo-registry.schema.json 的 docPath 根域约束与此保持同步（变更时两处同改）。",
  "type": "object",
  "required": ["version", "rootDomains", "namingRules", "frontmatter"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "rootDomains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/domainPath" }
    },
    "namingRules": {
      "type": "object",
      "required": ["pathStyle", "forbiddenChars", "maxSegmentLength"],
      "additionalProperties": false,
      "properties": {
        "pathStyle": { "const": "lowercase-hyphen" },
        "forbiddenChars": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "maxLength": 1 }
        },
        "maxSegmentLength": { "type": "integer", "minimum": 1 },
        "note": { "type": "string" }
      }
    },
    "childrenTemplate": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/childrenRule" }
    },
    "frontmatter": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "autoGenerated": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "domainPath": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
    },
    "childrenRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "packageTreeRule": { "type": "string" },
        "note": { "type": "string" },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
