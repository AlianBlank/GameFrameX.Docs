{
  "$schema": "./catalog-template.schema.json",
  "version": "1.0.0",
  "description": "GameFrameX 文档目录最小骨架模板。Phase 1 起按需扩展 childrenTemplate、frontmatter 强制字段等。当前 5 语言 docs/<lang>/ 已存在,本文件仅锁定命名约定和 9 个一级域的目录名(已就位),不预生成更细的子节点。",
  "rootDomains": [
    "guide",
    "architecture",
    "components/unity",
    "components/server",
    "components/foundation",
    "components/godot",
    "admin",
    "data-and-config",
    "tools-and-specification"
  ],
  "namingRules": {
    "pathStyle": "lowercase-hyphen",
    "forbiddenChars": ["_", " "],
    "maxSegmentLength": 64
  },
  "frontmatter": {
    "required": ["title", "order"],
    "autoGenerated": {
      "source.repo": "string",
      "source.commit": "sha",
      "source.generator": "string"
    }
  }
}
